# Copy to .env.local for local development. Never commit real values.
# Validated at startup by src/config/env.ts.

# Public origin of the deployment, used for absolute URLs and Origin checks.
APP_URL=http://localhost:3000

# Postgres connection string. Local: `pnpm db:up`. Neon: use the pooled endpoint.
DATABASE_URL=postgres://pos:pos@localhost:5432/pos

# Exposes /api/v1/diagnostics and the /ui component showcase. Keep "false" in production.
ENABLE_DIAGNOSTICS=false

# Upstash Redis REST credentials for the per-IP login limit. Optional locally
# (an in-memory limiter is used); required in production.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# First owner account, read only by `pnpm db:seed`.
SEED_OWNER_USERNAME=owner
SEED_OWNER_NAME=Owner
SEED_OWNER_PASSWORD=change-me-please
